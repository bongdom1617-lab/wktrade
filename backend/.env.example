# GOLD AI Backend Configuration (keep all secrets strictly server-side)
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database: defaults to local SQLite (gold_ai.db).
# For PostgreSQL or Supabase, set DATABASE_URL:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Optional enterprise market data API key (works out-of-the-box via BiQuote + Swissquote BBO with zero keys)
# TWELVE_DATA_API_KEY=
# PREFERRED_PROVIDER=auto

# Risk & staleness settings
MIN_RISK_REWARD=2.0
QUOTE_DELAYED_THRESHOLD_SEC=20
QUOTE_DISCONNECTED_THRESHOLD_SEC=120
SIGNAL_DEDUP_COOLDOWN_SEC=900
SIGNAL_MIN_CONFIDENCE=62
